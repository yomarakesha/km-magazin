# Copy to .env.local and fill in for your environment.

# Backend origin used by Next.js SSR (server-side fetches)
API_URL=http://localhost:8000

# Backend origin used by the browser (shop client + admin panel)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: separate origin for product media if it differs from the API
# NEXT_PUBLIC_MEDIA_URL=http://localhost:8000

# Public canonical origin of the site (SEO: canonical/sitemap/JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for POST /api/revalidate (cache invalidation pinged by the
# backend after admin writes). Must match REVALIDATE_SECRET in backend/.env.
REVALIDATE_SECRET=

# Optional: Sentry error tracking (server / browser). Empty = disabled.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
