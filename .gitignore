# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/.pytest_cache/
.pytest_cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# browser-automation artifacts (playwright / mcp session dumps)
.playwright-mcp/

# ad-hoc screenshots at repo root / scripts (dev artifacts, not site assets)
/*.png
/*.jpeg
/*.jpg
/scripts/*.png
/backend/*.png

# env files (can opt-in for committing if needed)
.env*
!.env.example
!backend/.env.example

# sqlite snapshots from scripts/backup-db.ps1
/backup/

# python backend
__pycache__/
*.pyc
/backend/.venv/
/backend/venv/
/backend/data/
/backend/media/
/backend/app/seed_data.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
