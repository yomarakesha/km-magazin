# Copy to backend/.env and fill in. The app REFUSES to start without
# ADMIN_PASSWORD and SECRET_KEY (fail-closed). Generate both with:
#   powershell -ExecutionPolicy Bypass -File scripts/create-admin.ps1

# --- required ---
ADMIN_PASSWORD=
SECRET_KEY=

# --- environment ---
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_URL=http://localhost:8000

# Set to true in production (cookie sent over HTTPS only)
COOKIE_SECURE=false

# Shared secret for pinging the frontend's POST /api/revalidate after admin
# writes. Must match REVALIDATE_SECRET in the frontend .env.local.
# Empty = disabled (frontend falls back to its 60s revalidate window).
REVALIDATE_SECRET=

# Admin session lifetime in hours (default: 168 = 7 days)
# SESSION_HOURS=168

# Override DB location if needed (default: backend/data/km.db)
# DATABASE_URL=sqlite:///path/to/km.db

# --- optional: Sentry error tracking ---
# SENTRY_DSN=

# --- optional: Telegram order notifications ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- optional: email notifications (order status changes) ---
# Enabled when SMTP_HOST and SMTP_TO are both set.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=

# --- optional: online payments ---
# Active provider from backend/app/payments/ (default: manual — admin marks
# orders paid by hand). Real gateways (Halkbank/Rysgal/local processing) get
# registered there before switching this.
# PAYMENT_PROVIDER=manual
